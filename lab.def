Bootstrap: localimage
From: frontend.sif

%files
    lab.yml /opt/lab.yml

%post
    /opt/conda/bin/conda env create -n lab -f /opt/lab.yml
    /opt/conda/bin/conda clean --all -y
    /opt/conda/bin/conda list -n lab --explicit > /opt/conda/envs/lab/lock.txt

    # Show the lab env as the "Lab env" kernel
    /opt/conda/envs/lab/bin/python -m ipykernel install --prefix /opt/jupyter \
        --name lab-env --display-name "Lab env"

%test
    /opt/conda/envs/lab/bin/python -c "import ipykernel"
